cabal-version:       2.2

name:                HaikuWhisperer
version:             0.1.0.0
-- synopsis:
-- description:
homepage:            https://github.com/ValdemarPospisil/HaikuWhisperer#readme
license:             BSD-3-Clause
license-file:        LICENSE
author:              Valdemar 
maintainer:          valda.pospisil.02@gmail.com
copyright:           2025 Valdemar Pospíšil
category:            Web
build-type:          Simple
extra-source-files:  README.md
                     CHANGELOG.md

executable HaikuWhisperer
  hs-source-dirs:      src
  main-is:             Main.hs
  default-language:    Haskell2010
  build-depends:       base >= 4.7 && < 5
                     ,  random
  ghc-options:         -Wall
                       -Wcompat
                       -Widentities
                       -Wincomplete-record-updates
                       -Wincomplete-uni-patterns
                       -Wmissing-export-lists
                       -Wmissing-home-modules
                       -Wpartial-fields
                       -Wredundant-constraints
